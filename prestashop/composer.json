{
    "name": "vocify-ai/prestashop-module",
    "description": "Vocify AI - Order Confirmation Calls Module for PrestaShop",
    "type": "prestashop-module",
    "license": "MIT",
    "version": "1.2.0",
    "authors": [
        {
            "name": "Vocify AI",
            "email": "developers@vocify-ai.com",
            "homepage": "https://vocify-ai.com"
        }
    ],
    "require": {
        "php": ">=7.1.0",
        "giggsey/libphonenumber-for-php": "^8.13"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^8.5 || ^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "classmap": [
            "classes/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "7.2.34"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php -l vocifyai.php && find classes controllers upgrade -name '*.php' -print0 | xargs -0 -n1 -- php -l",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "vendor/bin/phpcs"
    }
}
